# Public (browser-safe) values only. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to true only after an SMS provider is configured in Supabase Auth
VITE_PHONE_OTP=false
# Google Maps JavaScript API key (restrict to your site URL). Leave empty to use OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
