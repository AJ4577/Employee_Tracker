# Public values only (bundled into the app). NEVER put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Web app URL (used for the Register link)
EXPO_PUBLIC_WEB_URL=https://aj4577.github.io/Employee_Tracker/
# Set to true only after an SMS provider is configured in Supabase Auth
EXPO_PUBLIC_PHONE_OTP=false
# Google Maps JavaScript API key (same browser key; restrict to the web app URL). Empty = OpenStreetMap.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
